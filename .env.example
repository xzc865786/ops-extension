# Database
DATABASE_URL=postgresql+psycopg://ops:ops_change_me@ops-db:5432/qiyuan_ops

# Sub2API identity
SUB2API_BASE_URL=http://sub2api:8080

# Session
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=24
COOKIE_NAME=ops_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Public origin (no trailing slash)
PUBLIC_BASE_URL=https://api.example.com

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_BUCKET=qiyuan-ops
MINIO_USE_SSL=false

# Attachments
ATTACHMENT_MAX_BYTES=20971520

# Optional
CORS_ORIGINS=
LOG_LEVEL=INFO
DEV_AUTH_BYPASS=false
