# Database
DATABASE_URL=postgresql+psycopg://ops:ops_change_me@ops-db:5432/qiyuan_ops

# Sub2API identity
SUB2API_BASE_URL=http://sub2api:8080

# Session — Sub2API bearer is NEVER persisted (DB / redis / files).
# Custom Menu URLs must hit /ext/auth/bootstrap so each entry refreshes the session.
SESSION_SECRET=change-me-to-a-long-random-string
# Absolute session cookie / row TTL (hours). Default 2.
SESSION_TTL_HOURS=2
# Max seconds since last Bootstrap before API clears session and returns
# 401 SESSION_REBOOTSTRAP_REQUIRED (client must re-open menu → bootstrap).
# Default 7200 (2h). Role/status snapshots are trusted until then.
SESSION_MAX_AGE_WITHOUT_BOOTSTRAP=7200
COOKIE_NAME=ops_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Public origin (no trailing slash)
PUBLIC_BASE_URL=https://api.example.com

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_BUCKET=qiyuan-ops
MINIO_USE_SSL=false
# Optional: browser-reachable host for presigned download redirects.
# If unset, downloads stream through the authenticated API proxy (recommended).
# MINIO_PUBLIC_ENDPOINT=files.example.com:9000
# MINIO_PUBLIC_URL=https://files.example.com

# Attachments
ATTACHMENT_MAX_BYTES=20971520

# Optional
CORS_ORIGINS=
LOG_LEVEL=INFO
DEV_AUTH_BYPASS=false
